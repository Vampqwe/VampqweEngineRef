     /**
-     * Счётчик просмотров страницы.
-     * Без троттлинга каждый GET выполнял UPDATE в БД — боты раздували
-     * строку таблицы и создавали гонку обновлений (DoS-усилитель).
+     * Счётчик просмотров страницы (асинхронный, см. ViewCounter).
+     * Просмотры копятся в буфере (Redis либо storage/view_counter.json)
+     * и списываются в БД пакетно — одним UPDATE на пачку, а не на каждый GET.
      */
     'views' => [
         // Учитывать ли просмотры вообще.
         'count_enabled' => true,
 
-        // Сколько секунд засчитывать только один просмотр на страницу+IP.
+        // Сколько секунд засчитывать только один просмотр на страницу+посетитель.
         'throttle_seconds' => 300,
+
+        // Асинхронный режим: true — буфер + пакетный flush; false — прежний
+        // синхронный UPDATE на каждый просмотр (режим совместимости).
+        'async' => true,
+
+        // Когда в буфере накоплено N просмотров — планировать списание.
+        'flush_threshold' => 50,
+
+        // Минимальный интервал между списаниями, сек (защита от «лавины»
+        // concurrent-flush при пиковом трафике).
+        'flush_cooldown_seconds' => 10,
+
+        // TTL ключей буфера в Redis, сек (страховка от течения счётчиков).
+        'buffer_ttl' => 86400,
+
+        // Максимум страниц в одном пакетном UPDATE (защита от раздувания
+        // запроса и длинных блокировок).
+        'max_keys_per_flush' => 500,
+
+        // Лимит записей в файловом буфере (когда Redis недоступен).
+        'file_max_pages' => 1000,
     ],
 ];
