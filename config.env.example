# =====================================================================
# VampqweEngine — шаблон конфигурации. Скопируйте в config.env и
# заполните значения под своё окружение. Формат: KEY=value, строки с #
# игнорируются; пути задаются ОТНОСИТЕЛЬНО APP_ROOT_PATH («/» = корень
# проекта, а не диск). Значения по умолчанию безопасны для продакшена.
# =====================================================================

# ---------------------------------------------------------------
# 1. ПРИЛОЖЕНИЕ (общие параметры)
# ---------------------------------------------------------------
# Абсолютный путь к каталогу с index.php. Единственный канонический
# корень проекта: все пути (storage/, logs/, views/) вычисляются от него.
APP_ROOT_PATH=/var/www/h187763/data/www/test.103vet.by
APP_NAME=Достойный уход
APP_BASE_URL=https://usyplenie.103vet.by
# Allowlist доменов из Host-заголовка через запятую; пусто = проверка выкл.
APP_ALLOWED_HOSTS=usyplenie.103vet.by,test.103vet.by,localhost
# true = dev-режим: подробные ошибки, full-page cache принудительно выкл.
APP_DEBUG=false
# Диагностика только для loopback-запросов; на проде держите false.
DEV_PREVIEW_ENABLED=false

# ---------------------------------------------------------------
# 2. ДАТА / ВРЕМЯ
# ---------------------------------------------------------------
TIMEZONE=Europe/Moscow
DATE_FORMAT=Y-m-d
TIME_FORMAT=H:i:s
DATETIME_FORMAT=Y-m-d H:i:s
LOCALE=ru_RU

# ---------------------------------------------------------------
# 3. БАЗА ДАННЫХ (боевая БД — только MySQL/MariaDB)
# ---------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=usyplenie-103vet
DB_USER=vampqwe
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4
# Таймаут установки соединения с MySQL, сек.
DB_CONNECT_TIMEOUT_S=5
# Режим ошибок PDO: exception|warning|null.
DB_PDO_ERRMODE=exception
# Режим выборки по умолчанию: assoc|num|both.
DB_PDO_FETCH_MODE=assoc
# Persistent-соединения PDO (пул на уровне PHP); при высокой нагрузке — true.
DB_PDO_PERSISTENT=false
# Проверять доступность БД при старте движка.
DB_CHECK_ON_BOOT=false
# Разрешать БД-слою только prepared-запросы (защита от инъекций).
DB_ENFORCE_PREPARED=true

# ---------------------------------------------------------------
# 4. ФАЙЛОВАЯ СИСТЕМА
# ---------------------------------------------------------------
# Права создаваемых файлов/каталогов (octal).
FS_DEFAULT_FILE_PERMISSION=0775
FS_DEFAULT_DIR_PERMISSION=0775
# Максимальный размер загружаемого файла, байт (здесь 10 МБ).
FS_MAX_FILE_SIZE=10485760
FS_ENCODING=UTF-8
# Запрещать файловым операциям выходить за пределы проекта.
FS_ENFORCE_BASE_PATH=false

# ---------------------------------------------------------------
# 5. ШАБЛОНИЗАТОР
# ---------------------------------------------------------------
# Компиляция шаблонов в кеш views/ (держите true на проде).
TEMPLATE_CACHE=true
TEMPLATE_EXTENSION=.html
# Максимальная глубина вложенности @extends/@include.
TEMPLATE_MAX_RENDER_DEPTH=10

# ---------------------------------------------------------------
# 6. ЛОГИРОВАНИЕ
# ---------------------------------------------------------------
LOG_ENABLED=true
# Минимальный уровень: debug|info|warning|error|critical.
LOG_LEVEL=info
# Путь к файлу лога ОТНОСИТЕЛЬНО APP_ROOT_PATH.
LOG_FILE=/logs/app.log
LOG_DATE_FORMAT=Y-m-d H:i:s.u
# Ротация по размеру, байт.
LOG_MAX_SIZE=10485760
LOG_ROTATION=true
# Маскировать чувствительные поля (пароли, токены) в записях лога.
LOG_MASK_SENSITIVE=true

# ---------------------------------------------------------------
# 7. БЕЗОПАСНОСТЬ: базовое, CSRF, заголовки, CSP, аудит
# ---------------------------------------------------------------
# Жёсткая проверка прав доступа к config.env (запрет world-access).
SECURITY_ENFORCE_CONFIG_PERMS=true
# IP/CIDR обратных прокси, чьим X-Forwarded-* можно верить; пусто = никто.
TRUSTED_PROXIES=
# CSRF-защита форм и POST-запросов.
SECURITY_CSRF_ENABLED=true
SECURITY_CSRF_TOKEN_NAME=_csrf_token
# Время жизни CSRF-токена, сек.
SECURITY_CSRF_EXPIRE=3600
# Безопасные HTTP-заголовки и CSP в ответах.
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
# Inline JS запрещён: доверенные inline-элементы получают nonce;
# style-src-attr оставлен для CMS style-атрибутов. JavaScript страниц
# храните в поле scripts (URL проверяется allowlist).
# ВАЖНО: 'unsafe-inline' в style-src обязателен для импортных страниц —
# их дизайн живёт в атрибутах style="" (геро-блоки, info-box и т.п.).
# Без него браузер отрисовывает «голый» HTML (страница выглядит сломанной),
# даже когда контент в БД побитно корректен. Движок разрешает unsafe-inline
# в style-src только при явно настроенном style-src-attr 'unsafe-inline'.
SECURITY_CSP_POLICY=default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com; font-src 'self' data: https://fonts.gstatic.com
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# HSTS (только при работе по HTTPS).
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
# Журнал событий безопасности; путь ОТНОСИТЕЛЬНО APP_ROOT_PATH.
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_FILE=/logs/audit.log
# Ключи, значения которых вырезаются из логов/аудита.
SECURITY_SENSITIVE_KEYS=password,passwd,pass,pwd,token,secret,api_key,apikey,authorization,cookie,session,credit_card,card_number,cvv,ssn

# ---------------------------------------------------------------
# 8. СЕССИИ (драйвер хранения + cookie)
# ---------------------------------------------------------------
# Strict mode отвергает неизвестные session ID; SID только через cookie.
SESSION_STRICT_MODE=true
# Secure-флаг cookie: на HTTPS-проде держите true даже за TLS-прокси;
# локальный HTTP — false. Не определяйте по непроверенному X-Forwarded-Proto.
SESSION_COOKIE_SECURE=true
# HttpOnly — cookie недоступна из JS; SameSite=Lax — защита от CSRF-посылок.
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_PATH=/
# Драйвер: files (по умолчанию, штатный обработчик PHP) или redis
# (убирает блокировки файлов, позволяет масштабировать на несколько нод;
# требует расширение phpredis).
SESSION_DRIVER=files
# Lazy-миграция: при SESSION_DRIVER=redis файловые сессии переносятся
# в Redis при первом чтении — активные пользователи не выпадают.
SESSION_MIGRATE_ON_READ=true
# Подключение Redis для сессий (используется только при SESSION_DRIVER=redis).
SESSION_REDIS_HOST=127.0.0.1
SESSION_REDIS_PORT=6379
SESSION_REDIS_TIMEOUT=2.0
SESSION_REDIS_PASSWORD=
SESSION_REDIS_DB=0
SESSION_REDIS_PREFIX=vampqwe:sess:

# ---------------------------------------------------------------
# 9. RATE LIMITING (глобальное ограничение частоты запросов)
# ---------------------------------------------------------------
# Общий выключатель лимитера (429 Too Many Requests при превышении).
SECURITY_RATE_LIMIT_ENABLED=true
# Максимум запросов на IP+путь за окно; /admin и /install имеют свои лимиты.
SECURITY_RATE_LIMIT_MAX=60
# Размер скользящего окна, сек.
SECURITY_RATE_LIMIT_WINDOW=60
# Учитывать id пользователя в ключе лимита (персональный лимит авторизованных).
SECURITY_RATE_LIMIT_INCLUDE_USER=false

# ---------------------------------------------------------------
# 10. FULL-PAGE CACHE (HTML-страницы для анонимных посетителей)
# ---------------------------------------------------------------
# По умолчанию ВЫКЛЮЧЕН; включать на проде при APP_DEBUG=false
# (в dev-режиме middleware отключает кеширование принудительно).
PAGE_CACHE_ENABLED=false
# TTL свежести страницы, сек (попадает в Cache-Control:max-age ответа).
PAGE_CACHE_TTL=3600
# Страницы крупнее этого размера не кешируются, байт.
PAGE_CACHE_MAX_SIZE=1048576
# Период отдачи «протухшего» кеша при сбое бэкенда (stale-if-error), сек.
PAGE_CACHE_STALE=86400
# Каталог хранилища ОТНОСИТЕЛЬНО APP_ROOT_PATH; пусто = storage/cache/pages.
PAGE_CACHE_DIR=/storage/cache/pages

# ---------------------------------------------------------------
# 11. АСИНХРОННЫЙ СЧЁТЧИК ПРОСМОТРОВ
# ---------------------------------------------------------------
# Буфер накопления просмотров перед пакетной записью в БД; путь
# ОТНОСИТЕЛЬНО APP_ROOT_PATH, пусто = storage/view_counter.json.
# Если задан REDIS_HOST — буфер пишется в Redis вместо файла.
VIEW_COUNTER_FILE=/storage/view_counter.json
# Общие параметры Redis (счётчик просмотров; сессии — см. блок 8).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=vampqwe:views:

# ---------------------------------------------------------------
# 12. ОЧЕРЕДЬ ЗАДАЧ (воркер: bin/queue-work.php, cron --once)
# ---------------------------------------------------------------
# Выключатель фоновых задач (sitemap.rebuild, import.html).
QUEUE_ENABLED=true
# Попыток выполнения задачи до переноса в failed/.
QUEUE_DEFAULT_TRIES=3
# Пауза перед повтором неудачной задачи, сек (backoff).
QUEUE_RETRY_AFTER_SECONDS=60

# ---------------------------------------------------------------
# 13. СУПЕР-АДМИНИСТРАТОР (в конфиге, не в БД; несъём из админки)
# ---------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@usyplenie.103vet.by
SUPER_ADMIN_NAME=Супер Администратор
# Хэш: php -r "echo password_hash('ПАРОЛЬ', PASSWORD_BCRYPT, ['cost' => 12]);"
# Сам пароль нигде не хранится; при смене среды перегенерируйте хэш.
SUPER_ADMIN_PASSWORD=$2y$12$REGENERATE_WITH_password_hash_YOUR_NEW_PASSWORD

# ---------------------------------------------------------------
# 14. АДМИН-ПАНЕЛЬ
# ---------------------------------------------------------------
# Постраничность списка страниц (переопределяется ?per_page=, максимум 100).
ADMIN_PER_PAGE=20

# ---------------------------------------------------------------
# 15. МАСТЕР УСТАНОВКИ (/admin/install)
# ---------------------------------------------------------------
# Ключ активации мастера (?key=... или заголовок X-Install-Key).
# Сгенерируйте: php -r "echo bin2hex(random_bytes(16));"
# После установки POST-запросы к мастеру блокируются (403).
INSTALL_KEY=REPLACE_WITH_random_bytes_16_hex
# HMAC-ключ шифрования временного конфига БД мастера установки.
# Сгенерируйте: php -r "echo bin2hex(random_bytes(32));"
# ВАЖНО: секрет не должен попадать в публичный репозиторий.
INSTALL_HMAC_KEY=REPLACE_WITH_random_bytes_32_hex
