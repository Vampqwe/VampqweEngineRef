# Copy to config.env and set APP_ROOT_PATH for this installation.
# APP_ROOT_PATH — ЕДИНСТВЕННАЯ каноническая настройка корневого (базового)
# пути проекта: абсолютный путь к каталогу с index.php (НЕ к storage/!).
# Все базовые пути в движке (storage/, logs/, views/, config/) вычисляются
# от APP_ROOT_PATH через ProjectRoot/PathResolver; Config::getStoragePath().
# Все файловые пути конфига (LOG_FILE, SECURITY_AUDIT_FILE и т.п.) задаются
# ОТНОСИТЕЛЬНО APP_ROOT_PATH; ведущий «/» — это корень проекта, а не диск:
#   FS_BASE_PATH=/storage  -> больше не нужен: APP_ROOT_PATH=корень,
#                             каталог storage/ вычисляется движком сам
#   LOG_FILE=/log/app.log  -> {APP_ROOT_PATH}/log/app.log
# Устаревший ключ FS_BASE_PATH (исторически указывал на …/storage) ПОЛНОСТЬЮ
# УПРАЗДНЁН и больше НЕ читается движком — удалите его из старых config.env.
APP_ROOT_PATH=/var/www/h187763/data/www/test.103vet.by
FS_DEFAULT_FILE_PERMISSION=0775
FS_DEFAULT_DIR_PERMISSION=0775
FS_MAX_FILE_SIZE=10485760
FS_ENCODING=UTF-8
FS_ENFORCE_BASE_PATH=false

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=usyplenie-103vet
DB_USER=vampqwe
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4
# Таймаут установки соединения с MySQL, сек (PDO::MYSQL_ATTR_CONNECT_TIMEOUT)
DB_CONNECT_TIMEOUT_S=5
# ВАЖНО: боевая БД движка — только MySQL/MariaDB.
# SQLite — зарезервированный драйвер для возможной реализации в будущем,
# в рабочем контуре не используется; параметр DB_PATH удалён из конфига.
DB_PDO_ERRMODE=exception
DB_PDO_FETCH_MODE=assoc
DB_PDO_PERSISTENT=false
DB_CHECK_ON_BOOT=false
DB_ENFORCE_PREPARED=true

# =====================================================
# СУПЕР-АДМИНИСТРАТОР
# Хранится в конфиге, а не в БД.
# Имеет абсолютные права, не может быть удалён через админку.
# =====================================================
SUPER_ADMIN_EMAIL=admin@usyplenie.103vet.by
SUPER_ADMIN_NAME=Супер Администратор
# Хэш пароля генерируется через php -r "echo password_hash('ВАШ_ПАРОЛЬ', PASSWORD_BCRYPT, ['cost' => 12]);"
# ВАЖНО: сам пароль нигде не хранится и не документируется; при смене среды
# перегенерируйте хэш и ротационьте SUPER_ADMIN_PASSWORD.
SUPER_ADMIN_PASSWORD=$2y$12$REGENERATE_WITH_password_hash_YOUR_NEW_PASSWORD

TIMEZONE=Europe/Moscow
DATE_FORMAT=Y-m-d
TIME_FORMAT=H:i:s
DATETIME_FORMAT=Y-m-d H:i:s
LOCALE=ru_RU

LOG_ENABLED=true
LOG_LEVEL=info
# Путь к файлу лога ОТНОСИТЕЛЬНО APP_ROOT_PATH (/ — корень проекта).
LOG_FILE=/logs/app.log
LOG_DATE_FORMAT=Y-m-d H:i:s.u
LOG_MAX_SIZE=10485760
LOG_ROTATION=true
LOG_MASK_SENSITIVE=true

SECURITY_ENFORCE_CONFIG_PERMS=true

# Reverse-proxy IPs/CIDRs allowed to set X-Forwarded-For and X-Forwarded-Proto.
# Leave empty when PHP is directly exposed; never trust these headers from all clients.
TRUSTED_PROXIES=
SECURITY_CSRF_ENABLED=true
SECURITY_CSRF_TOKEN_NAME=_csrf_token
SECURITY_CSRF_EXPIRE=3600

# PHP-сессии. Strict mode отвергает неизвестные идентификаторы, а use_only_cookies
# и запрет trans_sid не позволяют передавать session ID через URL.
SESSION_STRICT_MODE=true

# Production работает через HTTPS: оставьте Secure=true, в том числе за TLS-прокси.
# Для локального HTTP создайте config.env и установите SESSION_COOKIE_SECURE=false.
# Не определяйте Secure по непроверенному HTTP_X_FORWARDED_PROTO.
SESSION_COOKIE_SECURE=true

# HttpOnly запрещает чтение session cookie из JavaScript; SameSite=Lax добавляет
# защиту от межсайтовой отправки cookie, но не заменяет CSRF-токен приложения.
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_PATH=/
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_MAX=60
SECURITY_RATE_LIMIT_WINDOW=60
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true

# Inline JS запрещён: доверенные inline script/style элементы получают nonce.
# Для page.content доверенный HTML сохраняется, но inline event-атрибуты запрещены;
# JavaScript страницы храните отдельно в поле scripts, где URL проверяется allowlist.
# style-src-attr оставлен для существующих CMS style-атрибутов, без разрешения inline JS.
SECURITY_CSP_POLICY=default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self'; style-src-attr 'unsafe-inline';font-src 'self' data: https://fonts.gstatic.com
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_AUDIT_ENABLED=true
# Файл аудит-лога ОТНОСИТЕЛЬНО APP_ROOT_PATH (/ — корень проекта).
SECURITY_AUDIT_FILE=/logs/audit.log
SECURITY_SENSITIVE_KEYS=password,passwd,pass,pwd,token,secret,api_key,apikey,authorization,cookie,session,credit_card,card_number,cvv,ssn

APP_BASE_URL=https://usyplenie.103vet.by
# Allowlist доменов из Host-заголовка (через запятую). Пусто = проверка отключена.
# Рекомендуемое значение для прода: основной домен + www/тестовые поддомены.
APP_ALLOWED_HOSTS=usyplenie.103vet.by,test.103vet.by,localhost
APP_NAME=Достойный уход
APP_DEBUG=false
# Explicit opt-in for the loopback-only diagnostics preview; keep disabled in production.
DEV_PREVIEW_ENABLED=false

TEMPLATE_CACHE=true
TEMPLATE_EXTENSION=.html
# Максимальная глубина вложенности рендера шаблонов (@extends/@include)
TEMPLATE_MAX_RENDER_DEPTH=10

# Размер страницы в списке страниц админ-панели (можно переопределить запросом ?per_page=, максимум 100).
ADMIN_PER_PAGE=20

# =====================================================
# МАСТЕР УСТАНОВКИ (/admin/install)
# Ключ активации защищает мастер до создания учётных записей.
# Передаётся как ?key=... или заголовок X-Install-Key.
# Смените значение на случайное (php -r "echo bin2hex(random_bytes(16));").
# После завершения установки ключ можно отозвать — POST-запросы
# к мастеру блокируются InstallAccessMiddleware (403).
# =====================================================
INSTALL_KEY=REPLACE_WITH_random_bytes_16_hex

# Секретный HMAC-ключ для шифрования временного конфига БД мастера установки.
# Сгенерируйте: php -r "echo bin2hex(random_bytes(32));"
# ВАЖНО: этот секрет НЕ должен попадать в публичный репозиторий.
INSTALL_HMAC_KEY=REPLACE_WITH_random_bytes_32_hex
